<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Scribbl - Draw, Guess & Have Fun!</title>
    <meta name="description"
        content="Scribbl is a free online multiplayer drawing and guessing game. Draw, guess and have fun with friends!">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/indexcss.css">
</head>

<body>
    <div class="background-shapes">
        <div class="shape shape-1"></div>
        <div class="shape shape-2"></div>
        <div class="shape shape-3"></div>
        <div class="shape shape-4"></div>
        <div class="shape shape-5"></div>
        <div class="shape shape-6"></div>
    </div>

    <div class="page-wrapper">
        <div class="logo-section">
            <h1 class="logo">
                <span class="letter-s">S</span>
                <span class="letter-c">c</span>
                <span class="letter-r">r</span>
                <span class="letter-i">i</span>
                <span class="letter-b">b</span>
                <span class="letter-b">b</span>
                <span class="letter-l">l</span>
            </h1>
            <p class="tagline">Draw, Guess & Have Fun!</p>
        </div>

        <div class="container">
            <div class="card unified-card">
                <div class="card-header">
                    <h2>Play Scribbl!</h2>
                </div>
                <% if (locals.error === 'banned') { %>
                    <div id="banned" style="background-color: rgba(255, 0, 0, 0.1); color: #ff4444; padding: 12px; margin-bottom: 20px; border-radius: 8px; text-align: center; font-weight: bold; border: 1px solid rgba(255, 0, 0, 0.2);">
                        You have been banned from playing for spamming chat.
                    </div>
                <% } %>
                <p class="card-desc">Enter your username and click Play to draw & guess!</p>
                <form id="scribbl-lobby-form" action="/play-random" method="post">
                    <!-- Shared Username Input -->
                    <div class="input-group">
                        <input type="text" id="lobby-username" name="username" placeholder="Enter your name..." required>
                        <input type="hidden" id="lobby-room-code" name="roomCode" value="<%= locals.prefillRoom || '' %>">
                    </div>

                    <!-- Big Play Button -->
                    <button type="submit" id="btn-play-random" class="btn btn-play-random">
                        <span class="btn-text">Play!</span>
                    </button>

                    <!-- Actions Grid -->
                    <div class="actions-grid" style="margin-top: 15px;">
                        <button type="button" id="btn-create-private" class="btn btn-create-private">
                            <span class="btn-text">Create Private Room</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <footer class="footer">
            <p>Made with ❤️ | Scribbl Clone by <a href="https://panky.qzz.io" target="_blank">Pankaj
                    Jagadale</a></p>
        </footer>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const form = document.getElementById('scribbl-lobby-form');
            const usernameInput = document.getElementById('lobby-username');
            const roomCodeInput = document.getElementById('lobby-room-code');
            const btnPlayRandom = document.getElementById('btn-play-random');
            const btnCreatePrivate = document.getElementById('btn-create-private');
            
            const banned = document.getElementById("banned");
            if (banned) {
                setTimeout(() => {
                    banned.remove();
                }, 3000);
            }

            // Focus username input
            usernameInput.focus();

            btnPlayRandom.addEventListener('click', () => {
                if (roomCodeInput.value.trim()) {
                    form.action = '/join-room';
                } else {
                    form.action = '/play-random';
                }
            });

            // Create Private Room action
            btnCreatePrivate.addEventListener('click', () => {
                if (!usernameInput.value.trim()) {
                    usernameInput.reportValidity();
                    return;
                }
                form.action = '/create-room';
                form.submit();
            });

            // Smart Enter key handling
            usernameInput.addEventListener('keypress', (e) => {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    if (!usernameInput.value.trim()) {
                        usernameInput.reportValidity();
                        return;
                    }
                    if (roomCodeInput.value.trim()) {
                        form.action = '/join-room';
                    } else {
                        form.action = '/play-random';
                    }
                    form.submit();
                }
            });

            <% if (locals.prefillRoom) { %>
                btnPlayRandom.querySelector('.btn-text').textContent = 'Join Invited Room';
            <% } %>
        });
    </script>
</body>

</html>
