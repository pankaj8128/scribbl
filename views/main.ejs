<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Scribbl - Game Room</title>
  <link rel="icon" type="image/png" href="/images/logo.png">
  <meta name="description" content="Scribbl game room - Draw, guess and compete with friends!">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="style.css">
</head>

<body>

  <!-- Top Bar -->
  <div class="top-bar">
    <div class="top-bar-left">
      <a href="/">
        <img src="/images/scribbl_logo.png" alt="Scribbl" class="top-logo">
      </a>
    </div>
    <div class="top-bar-center">
      <div id="game-bar">
        <div class="game-info-pill timer-pill">
          <span class="pill-icon">⏱️</span>
          <span id="timer">0</span>
        </div>
        <div class="game-info-pill round-pill">
          <span class="pill-icon">🔄</span>
          <span id="round">
            <span class="round-prefix">Round </span>0<span class="round-sep-long"> of </span><span class="round-sep-short">/</span>3
          </span>
        </div>
        <div id="choose-words">
          <% if (game.started) {%>
            <button class="word">
              <%= "_ " .repeat(game.currentWord.length) %>
            </button>
            <% } %>
        </div>
      </div>
    </div>
    <div class="top-bar-right">
      <div id="room-code" class="room-code-container" title="Click to copy invite link">
        <button id="roomCode" class="room-code-btn">
          <span class="room-code-icon">🔗</span>
          <span class="room-code-text">Share Invite Link</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Main Content -->
  <div class="game-layout">

    <!-- Left: Player List -->
    <div class="player-list-container">
      <div class="panel-header">
        <span class="panel-icon">👥</span>
        <span class="panel-title">Players</span>
      </div>
      <div id="users-info"></div>
    </div>

    <!-- Center: Canvas -->
    <div class="main-game-container">
      <div class="canvas-wrapper">
        <canvas id="draw-container"></canvas>
        <div id="settings-overlay" class="settings-overlay" style="display: <%= game.isStarted ? 'none' : 'flex' %>;">
          <h2 class="settings-title">⚙️ Room Settings</h2>
          <div class="settings-form">
            <div class="setting-group">
              <label for="setting-rounds">Rounds</label>
              <input type="number" id="setting-rounds" value="<%= game.settings ? game.settings.rounds : 3 %>" min="1" max="10" <%= isOwner ? '' : 'disabled' %>>
            </div>
            <div class="setting-group">
              <label for="setting-drawTime">Draw Time in sec</label>
              <input type="number" id="setting-drawTime" value="<%= game.settings ? game.settings.drawTime : 80 %>" min="10" max="300" <%= isOwner ? '' : 'disabled' %>>
            </div>
            <div class="setting-group">
              <label for="setting-wordCount">Word Count</label>
              <input type="number" id="setting-wordCount" value="<%= game.settings ? game.settings.wordCount : 3 %>" min="1" max="5" <%= isOwner ? '' : 'disabled' %>>
            </div>
            <div class="setting-group">
              <label for="setting-customWords">Custom Words (min 10, comma separated)</label>
              <textarea id="setting-customWords" placeholder="e.g. apple, banana, car..." <%= isOwner ? '' : 'disabled' %>><%= game.settings ? game.settings.customWords : '' %></textarea>
            </div>
            <button id="save-settings-btn" class="save-settings-btn" style="display: <%= isOwner ? 'block' : 'none' %>;">Save Settings</button>
          </div>
        </div>
        <div id="round-announcement-overlay" class="round-announcement-overlay" style="display: none;">
          <h1 id="round-announcement-text">Round 1</h1>
        </div>
      </div>

      <div class="controls">
        <div class="controls-left">
          <button onclick="undo()" class="ctrl-btn" title="Undo">
            <img src="/images/undo.png" alt="Undo">
          </button>
          <button onclick="clearCanvas()" class="ctrl-btn" title="Clear Canvas">
            <img src="/images/clear.png" alt="Clear">
          </button>
        </div>
        <div class="controls-right">
          <button id="start" <%=isOwner ? "" : "disabled" %> style="display: <%= game.isStarted ? 'none' : 'flex' %>;">
            <span class="start-icon">▶</span>
            Start Game
          </button>
        </div>
      </div>
    </div>

    <!-- Right: Chat -->
    <div id="chat-container">
      <div class="panel-header">
        <span class="panel-icon">💬</span>
        <span class="panel-title">Chat</span>
      </div>
      <div class="chat-messages" id="chat-messages"></div>
      <div class="input-wrapper">
        <input type="text" class="msgBox" placeholder="Type your guess...">
        <button class="sendBtn">
          <span class="send-icon">➤</span>
        </button>
      </div>
    </div>

  </div>

  <script src="/globals.js"></script>
  <script src="/ui.js"></script>
  <script src="/canvas.js"></script>
  <script src="/socket.js"></script>
  <script src="/app.js"></script>
</body>

</html>
