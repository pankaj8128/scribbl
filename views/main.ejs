<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Scribbl - Game Room</title>
  <meta name="description" content="Scribbl game room - Draw, guess and compete with friends!">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="style.css">
  <script>
    window.isPublic = <%= game.isPublic ? 'true' : 'false' %>;
  </script>
</head>

<body>

  <!-- Top Bar -->
  <div class="top-bar">
    <div class="top-bar-left">
      <a href="/" style="text-decoration: none;">
        <span class="mini-logo">
          <span class="letter-s">S</span>
          <span class="letter-c">c</span>
          <span class="letter-r">r</span>
          <span class="letter-i">i</span>
          <span class="letter-b">b</span>
          <span class="letter-b">b</span>
          <span class="letter-l">l</span>
        </span>
      </a>
    </div>
    <div class="top-bar-center">
      <div id="game-bar">
        <div class="game-info-pill timer-pill">
          <span class="pill-icon">⏱️</span>
          <span id="timer">0</span>
        </div>
        <div class="game-info-pill round-pill">
          <span class="pill-icon">🔄</span>
          <span id="round">
            <span class="round-prefix">Round </span><%= game.round %><span class="round-sep-long"> of </span><span class="round-sep-short">/</span><%= game.settings.rounds %>
          </span>
        </div>
        <div id="choose-words">
          <% if (game.isStarted && game.wordLength) {%>
            <button class="word">
              <%= "_ ".repeat(game.wordLength).trim() %>
            </button>
          <% } %>
        </div>
      </div>
    </div>
    <div class="top-bar-right">
      <% if (!game.isPublic) { %>
        <div id="room-code" class="room-code-container" title="Click to copy invite link">
          <button id="roomCode" class="room-code-btn">
            <span class="room-code-icon">🔗</span>
            <span class="room-code-text">Share Invite Link</span>
          </button>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Main Content -->
  <div class="game-layout no-tools">

    <!-- Left: Player List -->
    <div class="player-list-container">
      <div class="panel-header">
        <span class="panel-icon">👥</span>
        <span class="panel-title">Players</span>
      </div>
      <div id="users-info"></div>
    </div>

    <!-- Center: Canvas -->
    <div class="canvas-wrapper">
        <canvas id="draw-container"></canvas>
        <div id="settings-overlay" class="settings-overlay" style="display: <%= game.isStarted ? 'none' : 'flex' %>;">
          <% if (game.isPublic) { %>
            <div class="public-waiting-container">
              <div class="waiting-spinner">⏳</div>
              <h2 class="waiting-title">Waiting for Players</h2>
              <p class="waiting-desc">Match will start automatically when at least 2 players join.</p>
              <div class="waiting-count">
                <span id="waiting-current-count"><%= users.length %></span> / <span class="count-max">8</span> players
              </div>
            </div>
          <% } else { %>
            <h2 class="settings-title">⚙️ Room Settings</h2>
            <div class="settings-form">
              <div class="setting-group">
                <label for="setting-rounds">Rounds</label>
                <input type="number" id="setting-rounds" value="<%= game.settings ? game.settings.rounds : 3 %>" min="1" max="10" <%= isOwner ? '' : 'disabled' %>>
              </div>
              <div class="setting-group">
                <label for="setting-drawTime">Draw Time in sec</label>
                <input type="number" id="setting-drawTime" value="<%= game.settings ? game.settings.drawTime : 80 %>" min="10" max="300" <%= isOwner ? '' : 'disabled' %>>
              </div>
              <div class="setting-group">
                <label for="setting-wordCount">Word Count</label>
                <input type="number" id="setting-wordCount" value="<%= game.settings ? game.settings.wordCount : 3 %>" min="1" max="5" <%= isOwner ? '' : 'disabled' %>>
              </div>
              <div class="setting-group">
                <label for="setting-customWords">Custom Words (min 10, comma separated)</label>
                <textarea id="setting-customWords" placeholder="e.g. apple, banana, car..." <%= isOwner ? '' : 'disabled' %>><%= game.settings ? game.settings.customWords : '' %></textarea>
              </div>
              <div class="settings-actions">
                <button id="save-settings-btn" class="save-settings-btn" style="display: <%= isOwner ? 'block' : 'none' %>;">Save Settings</button>
                <button id="start" class="start-btn" <%=isOwner ? "" : "disabled" %> style="display: <%= game.isStarted ? 'none' : 'flex' %>;">
                  <span class="start-icon">▶</span>
                  Start Game
                </button>
              </div>
            </div>
          <% } %>
        </div>
        <div id="round-announcement-overlay" class="round-announcement-overlay" style="display: none;">
          <h1 id="round-announcement-text">Round 1</h1>
        </div>
      </div>

      <!-- Skribbl Drawing Toolbar -->
      <div id="drawing-toolbar" class="drawing-toolbar" style="display: none;">
        <!-- Left: Selected Color Preview (Split Box) -->
        <div class="color-preview-box" id="color-preview-btn" title="Selected Color">
          <div class="color-preview-display" id="active-color-preview"></div>
        </div>

        <!-- Middle: Color Grid -->
        <div class="color-grid" id="color-palette">
          <!-- Column 1 -->
          <div class="color-column">
            <button class="color-btn" style="background-color: #ffffff;" data-color="#ffffff" title="White"></button>
            <button class="color-btn" style="background-color: #000000;" data-color="#000000" title="Black"></button>
          </div>
          <!-- Column 2 -->
          <div class="color-column">
            <button class="color-btn" style="background-color: #c1c1c1;" data-color="#c1c1c1" title="Light Gray"></button>
            <button class="color-btn" style="background-color: #4c4c4c;" data-color="#4c4c4c" title="Dark Gray"></button>
          </div>
          <!-- Column 3 -->
          <div class="color-column">
            <button class="color-btn" style="background-color: #ef130b;" data-color="#ef130b" title="Red"></button>
            <button class="color-btn" style="background-color: #740b07;" data-color="#740b07" title="Dark Red"></button>
          </div>
          <!-- Column 4 -->
          <div class="color-column">
            <button class="color-btn" style="background-color: #ff7100;" data-color="#ff7100" title="Orange"></button>
            <button class="color-btn" style="background-color: #a33300;" data-color="#a33300" title="Dark Orange"></button>
          </div>
          <!-- Column 5 -->
          <div class="color-column">
            <button class="color-btn" style="background-color: #ffe400;" data-color="#ffe400" title="Yellow"></button>
            <button class="color-btn" style="background-color: #a38e00;" data-color="#a38e00" title="Dark Yellow"></button>
          </div>
          <!-- Column 6 -->
          <div class="color-column">
            <button class="color-btn" style="background-color: #00cc00;" data-color="#00cc00" title="Green"></button>
            <button class="color-btn" style="background-color: #005800;" data-color="#005800" title="Dark Green"></button>
          </div>
          <!-- Column 7 -->
          <div class="color-column">
            <button class="color-btn" style="background-color: #00b2ac;" data-color="#00b2ac" title="Mint"></button>
            <button class="color-btn" style="background-color: #005753;" data-color="#005753" title="Dark Mint"></button>
          </div>
          <!-- Column 8 -->
          <div class="color-column">
            <button class="color-btn" style="background-color: #00e2ff;" data-color="#00e2ff" title="Cyan"></button>
            <button class="color-btn" style="background-color: #007b8a;" data-color="#007b8a" title="Dark Cyan"></button>
          </div>
          <!-- Column 9 -->
          <div class="color-column">
            <button class="color-btn" style="background-color: #0050cd;" data-color="#0050cd" title="Blue"></button>
            <button class="color-btn" style="background-color: #001f74;" data-color="#001f74" title="Dark Blue"></button>
          </div>
          <!-- Column 10 -->
          <div class="color-column">
            <button class="color-btn" style="background-color: #a500c2;" data-color="#a500c2" title="Purple"></button>
            <button class="color-btn" style="background-color: #580068;" data-color="#580068" title="Dark Purple"></button>
          </div>
          <!-- Column 11 -->
          <div class="color-column">
            <button class="color-btn" style="background-color: #f300c7;" data-color="#f300c7" title="Pink"></button>
            <button class="color-btn" style="background-color: #8c0053;" data-color="#8c0053" title="Dark Pink"></button>
          </div>
          <!-- Column 12 -->
          <div class="color-column">
            <button class="color-btn" style="background-color: #ffac8e;" data-color="#ffac8e" title="Peach"></button>
            <button class="color-btn" style="background-color: #b06246;" data-color="#b06246" title="Dark Peach"></button>
          </div>
          <!-- Column 13 -->
          <div class="color-column">
            <button class="color-btn" style="background-color: #a0522d;" data-color="#a0522d" title="Light Brown"></button>
            <button class="color-btn" style="background-color: #532b1d;" data-color="#532b1d" title="Dark Brown"></button>
          </div>
        </div>

        <!-- Brush Size Preview (Mobile Only) -->
        <div class="brush-preview-box" id="brush-preview-btn" title="Brush Size">
          <span class="size-dot dot-sm" id="active-brush-preview"></span>
        </div>

        <!-- Brush Sizes -->
        <div class="brush-sizes" id="brush-sizes-panel">
          <button class="size-btn" data-size="2" title="Ultra Thin (2px)">
            <span class="size-dot dot-xs"></span>
          </button>
          <button class="size-btn active" data-size="5" title="Small (5px)">
            <span class="size-dot dot-sm"></span>
          </button>
          <button class="size-btn" data-size="15" title="Medium (15px)">
            <span class="size-dot dot-md"></span>
          </button>
          <button class="size-btn" data-size="30" title="Large (30px)">
            <span class="size-dot dot-lg"></span>
          </button>
          <button class="size-btn" data-size="50" title="Giant (50px)">
            <span class="size-dot dot-xl"></span>
          </button>
        </div>

        <!-- Action Tools (Brush, Fill, Undo, Clear) -->
        <div class="drawing-tools">
          <div class="tool-btn-container">
            <span class="tool-key">B</span>
            <button class="action-btn active" id="btn-tool-brush" title="Pencil (B)">
              <svg viewBox="0 0 24 24" class="tool-svg">
                <path fill="currentColor" d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/>
              </svg>
            </button>
          </div>

          <div class="tool-btn-container">
            <span class="tool-key">F</span>
            <button class="action-btn" id="btn-tool-fill" title="Fill Shape (F)">
              <svg viewBox="0 0 24 24" class="tool-svg">
                <path fill="currentColor" d="M19.18 10.38l-7.78-7.78c-.78-.78-2.05-.78-2.83 0L3.11 8.06c-.78.78-.78 2.05 0 2.83l7.78 7.78c.78.78 2.05.78 2.83 0l5.46-5.46 3.1 3.1c.39.39 1.02.39 1.41 0l1.41-1.41c.39-.39.39-1.02 0-1.41l-5.92-5.91zm-7.07 6.36l-6.36-6.36 4.95-4.95 6.36 6.36-4.95 4.95z"/>
              </svg>
            </button>
          </div>

          <div class="tool-btn-container">
            <span class="tool-key">U</span>
            <button class="action-btn" id="btn-tool-undo" title="Undo (U)">
              <svg viewBox="0 0 24 24" class="tool-svg">
                <path fill="currentColor" d="M12.5 8c-2.65 0-5.05.99-6.9 2.6L2 7v9h9l-3.62-3.62c1.39-1.16 3.16-1.88 5.12-1.88 3.54 0 6.55 2.31 7.6 5.5l2.37-.78C21.08 11.03 17.15 8 12.5 8z"/>
              </svg>
            </button>
          </div>

          <div class="tool-btn-container">
            <span class="tool-key">C</span>
            <button class="action-btn" id="btn-tool-clear" title="Clear Canvas (C)">
              <svg viewBox="0 0 24 24" class="tool-svg">
                <path fill="currentColor" d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
              </svg>
            </button>
          </div>
        </div>
      </div>

    <!-- Right: Chat -->
    <div id="chat-container">
      <div class="panel-header">
        <span class="panel-icon">💬</span>
        <span class="panel-title">Chat</span>
      </div>
      <div class="chat-messages" id="chat-messages"></div>
    </div>
    <div class="input-wrapper">
      <input type="text" class="msgBox" placeholder="Type your guess...">
    </div>

  </div>

  <script src="/globals.js"></script>
  <script src="/ui.js"></script>
  <script src="/canvas.js"></script>
  <script src="/socket.js"></script>
  <script src="/app.js"></script>
</body>

</html>
